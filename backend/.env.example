# RAG-Wiki 环境变量模板
# 复制为 .env 后按需修改；.env 不入库，真实密钥只放这里和 config/application-local.yml
#
# 这里只放跟本机环境绑定的值：中间件连接、端口、模型凭据。
# 连接池大小、切分参数、拒答阈值、Agent 步数这些调优值只写在 config/application.yml 里，
# 带着实测出来的默认值；需要临时覆盖时，把 application.yml 里 ${} 中的变量名设进环境即可。
#
# 之所以不在这里把调优值再列一遍：两份默认值会漂移，
# 改了一处以为生效、实际被另一处盖住，排查起来很费时间。

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_DATABASE=rag_wiki
MYSQL_USER=rag_wiki
MYSQL_PASSWORD=rag_wiki
MYSQL_ROOT_PASSWORD=root123456

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=redis123456

# ---------- Elasticsearch ----------
ES_HOST=localhost
ES_PORT=19200
ES_URIS=http://localhost:19200
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# ---------- 应用 ----------
SERVER_PORT=8080
APP_PROFILE=local

# ---------- 模型：对话（在线问答主链路） ----------
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

# ---------- 模型：embedding（索引与查询必须同模型） ----------
# EMBEDDING_DIMENSIONS 必须与 ES 索引 dense_vector 的 dims 一致，改动即需重建索引
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# ---------- 模型：编译（Wiki 离线编译，可以用更贵的模型） ----------
COMPILE_BASE_URL=
COMPILE_API_KEY=
COMPILE_MODEL=

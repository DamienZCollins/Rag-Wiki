# RAG-Wiki 环境变量模板
# 复制为 .env 后按需修改；.env 不入库，真实密钥只放这里和 config/application-local.yml

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rag_wiki
MYSQL_USER=rag_wiki
MYSQL_PASSWORD=rag_wiki
MYSQL_ROOT_PASSWORD=root123456
MYSQL_POOL_MAX=20
MYSQL_POOL_MIN=5

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# ---------- Elasticsearch ----------
ES_HOST=localhost
ES_PORT=9200
ES_URIS=http://localhost:9200
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# ---------- 应用 ----------
SERVER_PORT=8080
APP_PROFILE=local

# ---------- 模型：对话（在线问答主链路） ----------
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=2048
CHAT_TIMEOUT=60s

# ---------- 模型：embedding（索引与查询必须同模型） ----------
# EMBEDDING_DIMENSIONS 必须与 ES 索引 dense_vector 的 dims 一致，改动即需重建索引
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60s

# ---------- 模型：编译（Wiki 离线编译，可以用更贵的模型） ----------
COMPILE_BASE_URL=
COMPILE_API_KEY=
COMPILE_MODEL=
COMPILE_TEMPERATURE=0.1
COMPILE_MAX_TOKENS=8192
COMPILE_TIMEOUT=180s

# ---------- Agent 内核 ----------
AGENT_MAX_STEPS=6
AGENT_SSE_TIMEOUT=180s
AGENT_HISTORY_MAX_MESSAGES=40

# ---------- 检索 ----------
ES_INDEX_ALIAS=knowledge_chunks
RAG_INDEX_SOURCE=doc
RAG_ANALYZER=cjk
RAG_RRF_K=60
RAG_CANDIDATE_WINDOW=50
RAG_TOP_K=8
RAG_REFUSE_BM25_THRESHOLD=0.5
RAG_REFUSE_VECTOR_THRESHOLD=0.35

# ---------- 快通道 ----------
FASTPATH_CACHE_TTL=300s
FASTPATH_MIN_CONFIDENCE=0.8
FASTPATH_DISTILL_MIN_HITS=3
FASTPATH_DISTILL_WINDOW_DAYS=7
